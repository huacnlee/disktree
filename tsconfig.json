{
  "extends": "./.nsh/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "target",
    ".runtime-source",
    ".build",
    ".venv",
    "out"
  ]
}
