diff --git a/crates/nsh-platform-linux/src/input.rs b/crates/nsh-platform-linux/src/input.rs
index 20b2b01..caccb8d 100644
--- a/crates/nsh-platform-linux/src/input.rs
+++ b/crates/nsh-platform-linux/src/input.rs
@@ -1843,9 +1843,17 @@ fn set_hovered(surface: &Surface, views: Vec<NshView>) {
     let old = std::mem::replace(&mut *surface.input.hovered.borrow_mut(), views.clone());
     for v in old.iter().filter(|v| !views.contains(v)) {
         set_state(surface, v, HOVERED, false);
+        let state = v.state();
+        if state.events.contains(EventKind::HoverOut) {
+            surface.event(state.id, EventKind::HoverOut, EventPayload::None);
+        }
     }
     for v in views.iter().filter(|v| !old.contains(v)) {
         set_state(surface, v, HOVERED, true);
+        let state = v.state();
+        if state.events.contains(EventKind::HoverIn) {
+            surface.event(state.id, EventKind::HoverIn, EventPayload::None);
+        }
     }
 }
 
